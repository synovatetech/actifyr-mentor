{
  "name": "actifyr-mentor-portal",
  "version": "1.0.0",
  "description": "Actifyr Mentor Portal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "commit": "cz",
    "commit:retry": "cz",
    "branch:new": "node scripts/git/create-branch-interactive.mjs",
    "branch:feat": "node scripts/git/create-branch.mjs feat",
    "branch:fix": "node scripts/git/create-branch.mjs fix",
    "branch:chore": "node scripts/git/create-branch.mjs chore",
    "sync:llj": "scripts/git/sync-to-llj.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.96.1",
    "@tiptap/extension-color": "^3.20.4",
    "@tiptap/extension-image": "^3.16.0",
    "@tiptap/extension-link": "^3.16.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-subscript": "^3.16.0",
    "@tiptap/extension-superscript": "^3.16.0",
    "@tiptap/extension-text-align": "^3.16.0",
    "@tiptap/extension-text-style": "^3.20.4",
    "@tiptap/extension-underline": "^3.16.0",
    "@tiptap/react": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.14",
    "formik": "^2.4.9",
    "framer-motion": "^12.35.1",
    "lottie-react": "^2.4.1",
    "next": "^15.3.1",
    "nextjs-toploader": "^3.9.17",
    "nprogress": "^0.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-quill": "^2.0.0-beta.2",
    "react-simple-wysiwyg": "^3.4.1",
    "suneditor-react": "^3.6.1",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5",
    "vercel": "^50.25.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "next lint --fix --file"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
