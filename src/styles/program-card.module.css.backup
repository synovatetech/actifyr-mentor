/* ============================================
   Program Card Styles
   Based on Figma design
   ============================================ */

.card {
  width: 565px;
  min-width: 565px;
  height: 370px;
  background: #FFFFFF;
  box-shadow: 0px 2px 4px rgba(111, 111, 111, 0.1);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}

/* Header Section with Gradient */
.header {
  width: 100%;
  height: 122px;
  background: #FCE8E2;
  border-radius: 12px 12px 0px 0px;
  padding: 19px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  position: relative;
  box-sizing: border-box;
}

.imageContainer {
  flex-shrink: 0;
}

.image {
  width: 65px;
  height: 59px;
  object-fit: cover;
  border: 1px solid #F2F2F2;
  border-radius: 5px;
}

.imagePlaceholder {
  width: 60px; /* Updated from 65px to match design */
  height: 60px; /* Updated from 59px to match design */
  background: #241E20;
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.imagePlaceholderText {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  color: #FFFFFF;
  text-align: center;
}

.programInfo {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-left: 12px;
  position: relative;
  min-width: 0;
}

.title {
  font-family: var(--font-sf-pro);
  font-size: 16px;
  line-height: 21px;
  font-weight: 400;
  color: rgba(30, 30, 30, 0.7);
  margin: 0;
}

.facilitator {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  color: rgba(30, 30, 30, 0.7);
  margin: 0;
}

.workshopDate {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  color: rgba(30, 30, 30, 0.7);
  margin: 0;
}

.ratingContainer {
  position: absolute;
  top: 63px; /* Positioned in header, below the workshop date line */
  right: 19px;
  display: flex;
  align-items: center;
  z-index: 1;
}

.rating {
  display: flex;
  align-items: center;
  gap: 3.49px;
  width: auto;
  height: auto;
}

.ratingValue {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 21px;
  font-weight: 510;
  color: #00B625;
  text-align: right;
}

.ratingCount {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 21px;
  font-weight: 274;
  color: #EE4723;
}

.noRating {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 21px;
  font-weight: 510;
  color: rgba(0, 0, 0, 0.4);
}

.statusBadge {
  position: absolute;
  top: 19px; /* Top of header */
  right: 19px;
  width: 65px;
  height: 25px;
  background: #EE4723;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2; /* Above other elements */
}

.statusText {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  font-weight: 510;
  color: #FFFFFF;
  text-align: center;
}

/* Content Section */
.content {
  flex: 1;
  padding: 19px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  position: relative;
  box-sizing: border-box;
}

.dateInfo {
  display: flex;
  gap: 9px;
  width: 100%;
  max-width: 527px;
  height: 56px;
}

.dateItem {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  padding: 8px 12px;
  border: 1px solid rgba(111, 111, 111, 0.1);
  border-radius: 6px;
  min-width: 0;
  height: 56px;
  box-sizing: border-box;
}

.dateLabel {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  font-weight: 400;
  color: rgba(30, 30, 30, 0.7);
  margin: 0;
}

.dateValue {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  font-weight: 510;
  color: #1E1E1E;
  margin: 4px 0 0 0;
}

.progressSection {
  display: flex;
  flex-direction: row;
  gap: 19px;
  width: 100%;
  max-width: 527px;
}

.progressItem {
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 250px;
  min-width: 0;
  height: 63px;
  flex: 1;
}

.progressHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progressLabel {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  color: rgba(30, 30, 30, 0.7);
}

.progressValue {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  font-weight: 700;
  color: #EE4723;
  text-align: right;
}

.progressBar {
  width: 100%;
  max-width: 250px;
  height: 14px;
  background: rgba(111, 111, 111, 0.1);
  border: 1px solid rgba(30, 30, 30, 0.1);
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}

.progressFill {
  height: 100%;
  background: linear-gradient(90deg, #FE4435 0%, #FECB56 25%, #FEF14D 50%, #ABD454 75%, #4DCC66 100%);
  box-shadow: inset 0px 4px 4px rgba(0, 0, 0, 0.25);
  border-radius: 12px;
}

.stats {
  display: flex;
  gap: 20px;
  width: 100%;
  max-width: 338px; /* 159px * 2 + 20px gap */
}

.statItem {
  width: 159px;
  height: 40px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border-radius: 6px;
  box-sizing: border-box;
  position: relative;
  flex-shrink: 0;
}

.statItem:first-child {
  background: rgba(191, 240, 222, 0.5);
  border: 1px solid #BFF0DE;
}

.statItem:last-child {
  background: rgba(205, 216, 247, 0.5);
  border: 1px solid #CDD8F7;
}

.statLabel {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  font-weight: 400;
  color: rgba(30, 30, 30, 0.8);
  text-align: center;
  position: absolute;
  left: 12px;
  top: 8px;
}

.statValue {
  font-family: var(--font-sf-pro);
  font-size: 14px;
  line-height: 17px;
  font-weight: 590;
  text-align: center;
  position: absolute;
  right: 12px;
  top: 8px;
}

.statItem:first-child .statValue {
  color: #007F54;
}

.statItem:last-child .statValue {
  color: #2D5AE9;
}

.actionMenu {
  position: absolute;
  bottom: 19px;
  right: 19px;
  width: 42px;
  height: 42px;
  border: 2px solid #EE4723;
  border-radius: 50%;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background-color 0.2s ease;
  z-index: 1;
}

.actionMenu:hover {
  background: rgba(238, 71, 35, 0.1);
}

.actionDots {
  display: grid;
  grid-template-columns: repeat(3, 6px);
  grid-template-rows: repeat(3, 6px);
  gap: 3px;
  width: 24px;
  height: 24px;
}

.actionDot {
  width: 6px;
  height: 6px;
  background: rgba(238, 71, 35, 0.8);
  border-radius: 6px;
}

